{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillbooks.ai/spec/v2/skillbook.schema.json",
  "title": "Skillbook Format v2 package manifest",
  "type": "object",
  "required": ["name", "version", "description", "license", "private", "skillbook"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      ]
    },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "private": { "const": true },
    "skillbook": { "$ref": "#/$defs/skillbook" }
  },
  "additionalProperties": true,
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "capability": {
      "type": "object",
      "required": ["id", "when", "outcome", "entry"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "when": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "(?:^|/)SKILL\\.md$" }
          ]
        },
        "evals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["scheme", "environment"],
      "properties": {
        "scheme": { "const": "bearer" },
        "environment": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "enum": ["local-first", "hosted-first", "local", "hosted"] },
        "local": {
          "type": "object",
          "required": ["root"],
          "properties": {
            "root": { "$ref": "#/$defs/relativePath" },
            "optional": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "hosted": {
          "type": "object",
          "properties": {
            "auth": { "$ref": "#/$defs/auth" },
            "versionHeader": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "properties": { "default": { "const": "local" } },
          "required": ["local"]
        },
        {
          "properties": { "default": { "const": "hosted" } },
          "required": ["hosted"]
        },
        {
          "properties": { "default": { "const": "local-first" } },
          "required": ["local", "hosted"]
        },
        {
          "properties": { "default": { "const": "hosted-first" } },
          "required": ["local", "hosted"]
        }
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["index", "search", "fetch", "delivery"],
      "properties": {
        "index": { "$ref": "#/$defs/relativePath" },
        "search": { "$ref": "#/$defs/relativePath" },
        "fetch": { "$ref": "#/$defs/relativePath" },
        "delivery": { "$ref": "#/$defs/delivery" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": ["enabled", "path", "index"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "$ref": "#/$defs/relativePath" },
        "index": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": false
    },
    "skillbook": {
      "type": "object",
      "required": ["title", "capabilities"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 },
        "server": { "type": "string", "format": "uri" },
        "pages": { "type": "integer", "minimum": 0 },
        "price": {
          "type": "string",
          "pattern": "^\\$[0-9]+(?:\\.[0-9]{2})$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "verified": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability" }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "sources": { "$ref": "#/$defs/sources" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resources": {
                "properties": {
                  "delivery": { "required": ["hosted"] }
                },
                "required": ["delivery"]
              }
            },
            "required": ["resources"]
          },
          "then": { "required": ["server"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
